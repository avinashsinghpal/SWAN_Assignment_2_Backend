# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tasklane?retryWrites=true&w=majority

# Authentication Secrets (minimum 32 characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS and Client URLs
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=

# Email / SMTP Configuration (Optional: Leave empty or disabled)
ENABLE_REMINDERS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="Tasklane Notifications <noreply@tasklane.com>"

# Seed Demo Passwords
ALLOW_SEED=true
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_USER_PASSWORD=UserPass123!

# Admin Registration Secret Key
ADMIN_SECRET_KEY=admin_secret_key_123
